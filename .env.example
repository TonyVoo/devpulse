# Copy to .env (git-ignored). Never commit real secrets.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse
POSTGRES_DB=devpulse
POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=8000
WEB_PORT=3000

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me-local-only-0123456789abcdefghijklmnop

# JSON list of allowed browser origins (the web app talks to the API server-side, so
# this is only needed for direct browser calls during development).
CORS_ORIGINS=["http://localhost:3000"]

# Fernet key for integration secrets (GitHub webhooks). LOCAL ONLY — generate your own:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=Zm9yLWxvY2FsLWRldi1vbmx5LW5vdC1hLXNlY3JldCE=

# --- AI investigator (docs/AI_ARCHITECTURE.md). Server-side only; never exposed to clients.
# Default: Google Gemini. A free key from https://aistudio.google.com/apikey works (free-tier
# requests may be used by Google to improve its products; use a paid key to opt out).
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3.8-flash
# Optional alternative: Anthropic Claude (paid).
ANTHROPIC_API_KEY=
# LOCAL ONLY: allows the rule-based demo analyzer ("fake" provider, labelled "not an LLM"
# in every client) so the AI flow works without a key. Refused when APP_ENV=production.
AI_FAKE_ENABLED=true

# Shared between the web BFF and the API so the API can trust the browser IP the BFF
# forwards (per-IP rate limits). LOCAL ONLY value — generate your own elsewhere:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_SHARED_SECRET=local-only-bff-secret-change-me-0123456789
# Reverse proxies in front of the API/web that append X-Forwarded-For (Render: 1).
TRUSTED_PROXY_HOPS=0
# uvicorn worker processes for the API (≈ CPU count; 1 on small instances).
WEB_CONCURRENCY=1

# Optional
SENTRY_DSN=

# For running the API/tests on the host (outside Docker) against the Compose databases.
DATABASE_URL=postgresql+asyncpg://devpulse:devpulse@localhost:55432/devpulse
REDIS_URL=redis://localhost:56379/0

# Web (Next.js BFF)
API_INTERNAL_URL=http://localhost:8000
# Shown to users in copy-paste examples (ingest curl). Public URL of the API.
API_PUBLIC_URL=http://localhost:8000
SESSION_COOKIE_SECURE=false
